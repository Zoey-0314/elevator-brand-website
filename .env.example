# Public site configuration
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase server-only configuration — never expose in browser code
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend server-only configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Website Inquiries <website@example.com>
INQUIRY_NOTIFICATION_EMAIL=sales@example.com
SEND_CUSTOMER_CONFIRMATION_EMAIL=false

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_EXPECTED_HOSTNAME=www.example.com

# Admin authorization
# Replace with the authorization mechanism documented by the implementation.
# Never treat all authenticated users as administrators by default.
ADMIN_EMAIL_ALLOWLIST=admin@example.com

# Optional abuse-protection settings; implementation must document its storage strategy.
INQUIRY_RATE_LIMIT_WINDOW_SECONDS=60
INQUIRY_RATE_LIMIT_MAX_REQUESTS=5

